# Image for running this repository's job as a Coolify scheduled task.
# The container only idles (CMD sleep infinity); each scheduled task runs its
# command inside it, the way Render's cron job ran its start command.
#
# Coolify: Build pack "Dockerfile", Dockerfile location "/Dockerfile.coolify",
# no domain, health check off. Scheduled task:
#   epg-grab               0 4 * * *                          timeout 11100 s
#     flock -n /tmp/epg-grab.lock timeout -k 60 10800 npm run epg:cron

FROM node:22-bookworm-slim
WORKDIR /app
# npm install's postinstall (npm run api:load) runs the repository's own
# scripts, so the whole repository goes in first, as on Render. HUSKY=0 skips
# the git-hooks setup, which has no .git to work on in an image.
ENV HUSKY=0
COPY . .
RUN npm install --no-audit --no-fund
CMD ["sleep", "infinity"]
